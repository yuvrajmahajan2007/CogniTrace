# CogniTrace Backend Environment Configuration
# Copy to .env for local overrides (never commit .env)

# SQLite database path (use an absolute persistent volume path in production, e.g. sqlite:////data/cognitrace.db)
SQLITE_DB_PATH=sqlite:///./cognitrace.db

# Persistent directories for uploaded files and generated reports
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Comma-separated allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Upload validation
MAX_UPLOAD_SIZE_MB=20
ALLOWED_TYPES=pdf,docx,txt,md,csv,json

# Optional Gemini API key (disabled by default; rule-based extraction always works without a key)
GEMINI_API_KEY=
