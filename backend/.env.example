# CogniTrace Backend Environment Configuration
# Copy to .env for local overrides (never commit .env)

# SQLite database path
SQLITE_DB_PATH=sqlite:///./cognitrace.db

# Persistent directories
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Upload validation
MAX_UPLOAD_SIZE_MB=20
ALLOWED_TYPES=pdf,docx,txt,md,csv,json

# Optional Gemini API key
GEMINI_API_KEY=
